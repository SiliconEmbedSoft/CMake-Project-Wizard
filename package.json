{
  "name": "cmake-project-wizard",
  "displayName": "CMake Project Wizard",
  "description": "Scaffold modular C/C++ CMake subprojects with clangd and CodeLLDB support.",
  "version": "1.0.1",
  "publisher": "siliconembedsoft-hq",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiliconEmbedSoft/CMake-Project-Wizard"
  },
  "icon": "icon.png",
  "author": {
    "name": "Nikhil Chaurasia",
    "email": "nikhilchaurasia2020@outlook.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Extension Packs",
    "Other"
  ],
  "keywords": [
    "cmake",
    "c++",
    "clangd",
    "lldb",
    "subproject"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:quickCMakeWizard.newSubproject"
  ],
  "extensionPack": [
    "llvm-vs-code-extensions.vscode-clangd",
    "llvm-vs-code-extensions.lldb-dap",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpp-devtools",
    "ms-vscode.cpptools-themes"
  ],
  "extensionDependencies": [
    "ms-vscode.cmake-tools"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quickCMakeWizard.newSubproject",
        "title": "New CMake Project...",
        "category": "CMake Wizard"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "quickCMakeWizard.newSubproject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@100"
        }
      ]
    }
  }
}
