{
  "name": "cmake-project-wizard",
  "displayName": "CMake Project Wizard",
  "description": "Scaffold modular C/C++ CMake subprojects with a CLion-style workflow, clangd IntelliSense, and LLDB-DAP debugging.",
  "version": "1.2.7",
  "publisher": "siliconembedsoft-hq",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiliconEmbedSoft/CMake-Project-Wizard"
  },
  "icon": "icon.png",
  "author": {
    "name": "Nikhil Chaurasia",
    "email": "nikhilchaurasia2020@outlook.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Extension Packs",
    "Other"
  ],
  "keywords": [
    "clion",
    "cmake",
    "c++",
    "c",
    "clangd",
    "lldb",
    "scaffold",
    "subproject",
    "workspace",
    "boilerplate",
    "generator",
    "template"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cmakeProjectWizard.createSubproject",
        "title": "Add CMake Subproject",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.convertToSingleProject",
        "title": "Convert to Single CMake Project",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newCSource",
        "title": "C Source File (.c)",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newCppSource",
        "title": "C++ Source File (.cpp)",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newHeader",
        "title": "Header File (.h/.hpp)",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newLibraryTarget",
        "title": "Library Target (CMake)",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.selectActiveTarget",
        "title": "Select Active Target",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.selectBuildType",
        "title": "Select Build Type",
        "category": "CMake Project Wizard"
      }
    ],
    "submenus": [
      {
        "id": "cmakeProjectWizard.newFile",
        "label": "CMake Wizard: New"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cmakeProjectWizard.createSubproject",
          "when": "explorerResourceIsFolder",
          "group": "cmakeProjectWizard@1"
        },
        {
          "command": "cmakeProjectWizard.convertToSingleProject",
          "when": "explorerResourceIsFolder",
          "group": "cmakeProjectWizard@2"
        },
        {
          "submenu": "cmakeProjectWizard.newFile",
          "group": "cmakeProjectWizard@3"
        }
      ],
      "cmakeProjectWizard.newFile": [
        {
          "command": "cmakeProjectWizard.newCSource",
          "group": "1_source@1"
        },
        {
          "command": "cmakeProjectWizard.newCppSource",
          "group": "1_source@2"
        },
        {
          "command": "cmakeProjectWizard.newHeader",
          "group": "1_source@3"
        },
        {
          "command": "cmakeProjectWizard.newLibraryTarget",
          "group": "2_target@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "CMake Project Wizard: General",
        "properties": {
          "cmakeProjectWizard.general.defaultLicense": {
            "type": "string",
            "default": "MIT",
            "description": "Default license for new projects."
          },
          "cmakeProjectWizard.general.commitLockfiles": {
            "type": "boolean",
            "default": false,
            "description": "Whether to include lockfiles in generated .gitignore."
          }
        }
      },
      {
        "title": "CMake Project Wizard: CMakeLists.txt Defaults",
        "properties": {
          "cmakeProjectWizard.cmake.cxxStandard": {
            "type": "string",
            "default": "20",
            "enum": ["11", "14", "17", "20", "23"],
            "description": "Default C++ standard for new projects."
          },
          "cmakeProjectWizard.cmake.cStandard": {
            "type": "string",
            "default": "17",
            "enum": ["99", "11", "17", "23"],
            "description": "Default C standard for new projects."
          },
          "cmakeProjectWizard.cmake.minimumRequired": {
            "type": "string",
            "default": "3.21",
            "description": "cmake_minimum_required version for new projects."
          },
          "cmakeProjectWizard.cmake.defaultBuildType": {
            "type": "string",
            "default": "Debug",
            "enum": ["Debug", "Release", "RelWithDebInfo", "MinSizeRel"],
            "description": "Default build type for new projects."
          }
        }
      },
      {
        "title": "CMake Project Wizard: CMakePresets.json Defaults",
        "properties": {
          "cmakeProjectWizard.presets.generator": {
            "type": "string",
            "default": "Ninja",
            "description": "Default generator for new projects."
          },
          "cmakeProjectWizard.presets.binaryDir": {
            "type": "string",
            "default": "${sourceDir}/build",
            "description": "Default binary directory for configure presets."
          }
        }
      },
      {
        "title": "CMake Project Wizard: Status Bar",
        "properties": {
          "cmakeProjectWizard.statusBar.showTarget": {
            "type": "boolean",
            "default": true,
            "description": "Show the active target in the status bar."
          },
          "cmakeProjectWizard.statusBar.showBuildType": {
            "type": "boolean",
            "default": true,
            "description": "Show the build type in the status bar."
          },
          "cmakeProjectWizard.statusBar.targetPriority": {
            "type": "number",
            "default": 10,
            "description": "Status bar priority for the target item (higher = further left). Start low so it sits right of clangd/debug."
          },
          "cmakeProjectWizard.statusBar.buildTypePriority": {
            "type": "number",
            "default": 9,
            "description": "Status bar priority for the build type item."
          }
        }
      }
    ]
  }
}
