{
  "name": "cmake-project-wizard",
  "displayName": "CMake Project Wizard",
  "description": "Scaffold modular C/C++ CMake subprojects with a CLion-style workflow, clangd IntelliSense, and LLDB-DAP debugging.",
  "version": "1.3.0",
  "publisher": "siliconembedsoft-hq",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiliconEmbedSoft/CMake-Project-Wizard"
  },
  "icon": "icon.png",
  "author": {
    "name": "Nikhil Chaurasia",
    "email": "nikhilchaurasia2020@outlook.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Extension Packs",
    "Other"
  ],
  "keywords": [
    "clion",
    "cmake",
    "c++",
    "c",
    "clangd",
    "lldb",
    "scaffold",
    "subproject",
    "workspace",
    "boilerplate",
    "generator",
    "template"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "llvm-vs-code-extensions.vscode-clangd",
    "llvm-vs-code-extensions.lldb-dap",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpp-devtools",
    "ms-vscode.cpptools-themes"
  ],
  "extensionPack": [
    "llvm-vs-code-extensions.vscode-clangd",
    "llvm-vs-code-extensions.lldb-dap",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpp-devtools",
    "ms-vscode.cpptools-themes"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cmakeProjectWizard.createSubproject",
        "title": "Add CMake Subproject",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.convertToSingleProject",
        "title": "Convert to Single CMake Project",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newSource",
        "title": "Source File (C / C++)",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newHeader",
        "title": "Header File (C / C++)",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newLibraryTarget",
        "title": "Library Target (C / C++)",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.selectActiveTarget",
        "title": "Select Active Target",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.selectBuildType",
        "title": "Select Build Type",
        "category": "CMake Project Wizard"
      }
    ],
    "submenus": [
      {
        "id": "cmakeProjectWizard.newFile",
        "label": "CMake Wizard: New"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cmakeProjectWizard.createSubproject",
          "when": "explorerResourceIsFolder",
          "group": "cmakeProjectWizard@1"
        },
        {
          "command": "cmakeProjectWizard.convertToSingleProject",
          "when": "explorerResourceIsFolder",
          "group": "cmakeProjectWizard@2"
        },
        {
          "submenu": "cmakeProjectWizard.newFile",
          "group": "cmakeProjectWizard@3"
        }
      ],
      "cmakeProjectWizard.newFile": [
        {
          "command": "cmakeProjectWizard.newSource",
          "group": "1_source@1"
        },
        {
          "command": "cmakeProjectWizard.newHeader",
          "group": "1_source@2"
        },
        {
          "command": "cmakeProjectWizard.newLibraryTarget",
          "group": "2_target@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "General",
        "properties": {
          "cmakeProjectWizard.general.defaultLicense": {
            "type": "string",
            "default": "MIT",
            "markdownDescription": "Default license for new projects.",
            "order": 1
          },
          "cmakeProjectWizard.general.commitLockfiles": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Whether to include lockfiles in generated `.gitignore`.",
            "order": 2
          },
          "cmakeProjectWizard.autoCleanupOnDelete": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Automatically remove `add_subdirectory(...)` entries from root `CMakeLists.txt` when a subproject folder is deleted.",
            "order": 3
          }
        }
      },
      {
        "title": "CMakeLists.txt Defaults",
        "properties": {
          "cmakeProjectWizard.cmake.cxxStandard": {
            "type": "string",
            "default": "20",
            "enum": ["11", "14", "17", "20", "23"],
            "markdownDescription": "Default C++ standard for new projects.",
            "order": 1
          },
          "cmakeProjectWizard.cmake.cStandard": {
            "type": "string",
            "default": "17",
            "enum": ["99", "11", "17", "23"],
            "markdownDescription": "Default C standard for new projects.",
            "order": 2
          },
          "cmakeProjectWizard.cmake.minimumRequired": {
            "type": "string",
            "default": "3.21",
            "markdownDescription": "`cmake_minimum_required` version for new projects.",
            "order": 3
          },
          "cmakeProjectWizard.cmake.defaultBuildType": {
            "type": "string",
            "default": "Debug",
            "enum": ["Debug", "Release", "RelWithDebInfo", "MinSizeRel"],
            "markdownDescription": "Default build type for new projects.",
            "order": 4
          }
        }
      },
      {
        "title": "CMakePresets.json Defaults",
        "properties": {
          "cmakeProjectWizard.presets.generator": {
            "type": "string",
            "default": "Ninja",
            "markdownDescription": "Default generator for new projects.",
            "order": 1
          },
          "cmakeProjectWizard.presets.binaryDir": {
            "type": "string",
            "default": "${sourceDir}/build",
            "markdownDescription": "Default binary directory for configure presets.",
            "order": 2
          }
        }
      },
      {
        "title": "Status Bar",
        "properties": {
          "cmakeProjectWizard.statusBar.showTarget": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Status Bar: show the active target item.",
            "order": 1
          },
          "cmakeProjectWizard.statusBar.showBuildType": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Status Bar: show the build type item.",
            "order": 2
          },
          "cmakeProjectWizard.statusBar.targetPriority": {
            "type": "number",
            "default": 49,
            "markdownDescription": "Status Bar: priority for the target item (higher = further left).",
            "order": 3
          },
          "cmakeProjectWizard.statusBar.buildTypePriority": {
            "type": "number",
            "default": 49,
            "markdownDescription": "Status Bar: priority for the build type item (higher = further left).",
            "order": 4
          }
        }
      }
    ]
  }
}
