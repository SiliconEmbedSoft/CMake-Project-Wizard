{
  "name": "cmake-project-wizard",
  "displayName": "CMake Project Wizard",
  "description": "Scaffold modular C/C++ CMake subprojects with a CLion-style workflow, clangd IntelliSense, and LLDB-DAP debugging.",
  "version": "1.2.1",
  "publisher": "siliconembedsoft-hq",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiliconEmbedSoft/CMake-Project-Wizard"
  },
  "icon": "icon.png",
  "author": {
    "name": "Nikhil Chaurasia",
    "email": "nikhilchaurasia2020@outlook.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Extension Packs",
    "Other"
  ],
  "keywords": [
    "clion",
    "cmake",
    "c++",
    "c",
    "clangd",
    "lldb",
    "lldb-dap",
    "subproject",
    "multi-target"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionPack": [
    "llvm-vs-code-extensions.vscode-clangd",
    "llvm-vs-code-extensions.lldb-dap",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpp-devtools",
    "ms-vscode.cpptools-themes"
  ],
  "extensionDependencies": [
    "llvm-vs-code-extensions.vscode-clangd",
    "llvm-vs-code-extensions.lldb-dap",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpp-devtools",
    "ms-vscode.cpptools-themes"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cmakeProjectWizard.newSubproject",
        "title": "New CMake Subproject...",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newCppClass",
        "title": "New C++ Class...",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newSourceFile",
        "title": "New C/C++ Source File...",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.newHeaderFile",
        "title": "New C/C++ Header File...",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.configure",
        "title": "Configure CMake Project",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.buildTarget",
        "title": "Build Target",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.runTarget",
        "title": "Run Target",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.debugTarget",
        "title": "Debug Target",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.selectActiveTarget",
        "title": "Select Active Target",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.selectBuildType",
        "title": "Select Build Type",
        "category": "CMake Project Wizard"
      },
      {
        "command": "cmakeProjectWizard.syncWorkspace",
        "title": "Sync Workspace Configuration",
        "category": "CMake Project Wizard"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cmakeProjectWizard.newSubproject",
          "when": "explorerResourceIsFolder",
          "group": "cmake_wizard_group@1"
        },
        {
          "command": "cmakeProjectWizard.newCppClass",
          "when": "explorerResourceIsFolder",
          "group": "cmake_wizard_group@2"
        },
        {
          "command": "cmakeProjectWizard.newSourceFile",
          "when": "explorerResourceIsFolder",
          "group": "cmake_wizard_group@3"
        },
        {
          "command": "cmakeProjectWizard.newHeaderFile",
          "when": "explorerResourceIsFolder",
          "group": "cmake_wizard_group@4"
        }
      ],
      "commandPalette": [
        {
          "command": "cmakeProjectWizard.buildTarget",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "cmakeProjectWizard.runTarget",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "cmakeProjectWizard.debugTarget",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "cmakeProjectWizard.newCppClass",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "cmakeProjectWizard.newSourceFile",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "cmakeProjectWizard.newHeaderFile",
          "when": "workspaceFolderCount != 0"
        }
      ]
    },
    "configuration": {
      "title": "CMake Project Wizard",
      "properties": {
        "cmakeProjectWizard.defaultCppStandard": {
          "type": "string",
          "default": "20",
          "enum": ["14", "17", "20", "23"],
          "description": "Default C++ standard offered first in the scaffolding wizard."
        },
        "cmakeProjectWizard.defaultCStandard": {
          "type": "string",
          "default": "17",
          "enum": ["99", "11", "17", "23"],
          "description": "Default C standard offered first in the scaffolding wizard."
        },
        "cmakeProjectWizard.defaultBuildType": {
          "type": "string",
          "default": "Debug",
          "enum": ["Debug", "Release", "RelWithDebInfo", "MinSizeRel"],
          "description": "Default CMake build type (CLion-style configuration)."
        },
        "cmakeProjectWizard.autoCleanupOnDelete": {
          "type": "boolean",
          "default": true,
          "description": "Automatically strip add_subdirectory(), clean stale build targets, and clean launch.json entries when a subproject folder is deleted."
        },
        "cmakeProjectWizard.autoReconfigureAfterScaffold": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run CMake configure after creating a new project/subproject so targets appear without reloading the window."
        }
      }
    }
  }
}
